{
  "id": "miku_chapter_02",
  "index": 2,
  "chapterLabel": "第二章",
  "title": "图文书库的午后",
  "synopsis": "一周过去，五姐妹依旧隔着你一层看不见的墙。午休的图书室里，借阅卡上反复出现的同一个名字，让你第一次真正走进了那个耳机女孩的世界。",
  "unlock": { "prevChapter": 1, "affection": 0 },
  "reward": { "affection": 5 },
  "bgm": "daily_piano",
  "casts": {
    "ichika":  { "name": "一花", "slot": "left" },
    "nino":    { "name": "二乃", "slot": "left" },
    "miku":    { "name": "三玖", "slot": "center" },
    "yotsuba": { "name": "四叶", "slot": "right" },
    "itsuki":  { "name": "五月", "slot": "right" }
  },
  "backgrounds": {
    "library":            { "label": "学校 · 图书室 · 午休", "top": "#F4E9D8", "bottom": "#B7A78D", "image": "story_bg/bg_school_library_noon.png" },
    "school_corridor":    { "label": "学校 · 走廊 · 午休后半", "top": "#E9EFF3", "bottom": "#B4C2CD", "image": "story_bg/bg_school_hallway_noon.png" },
    "courtyard_dusk":     { "label": "学校 · 中庭 · 长椅 · 放学后", "top": "#FBD9B4", "bottom": "#8F7FA8", "image": "story_bg/bg_school_courtyard_evening.png" },
    "courtyard_bench_cg": { "label": "学校 · 中庭 · 长椅", "top": "#FBD9B4", "bottom": "#8F7FA8", "image": "story_cg/cg_courtyard_bench.png" },
    "word_chain_cg":      { "label": "学校 · 中庭 · 长椅", "top": "#FBD9B4", "bottom": "#8F7FA8", "image": "story_cg/cg_word_chain.png" },
    "kitchen_evening":    { "label": "中野家 · 厨房 · 傍晚", "top": "#F7DCC4", "bottom": "#C79A82", "image": "story_bg/bg_nakano_kitchen_evening.png" },
    "dining_evening":     { "label": "中野家 · 餐桌 · 晚饭", "top": "#F3D9C2", "bottom": "#A8826C", "image": "story_bg/bg_nakano_dining_evening.png" },
    "corridor_night":     { "label": "中野家 · 走廊 · 夜晚", "top": "#2E2B44", "bottom": "#15131F", "image": "story_bg/bg_nakano_hallway_night.png" },
    "door_night_cg":      { "label": "中野家 · 走廊 · 夜晚", "top": "#2E2B44", "bottom": "#15131F", "image": "story_cg/cg_door_night.png" },
    "apartment_exterior": { "label": "公寓外 · 夜风", "top": "#1F2233", "bottom": "#0C0E16", "image": "story_bg/bg_nakano_entrance_night.png" }
  },
  "scenes": [
    {
      "id": "scene_library",
      "background": "library",
      "steps": [
        { "type": "narrate", "text": "距离你第一次踏进中野家，已经过去了一周。" },
        { "type": "narrate", "text": "这一周里，你和五姐妹的交集几乎为零。一花总是在你开口之前就用笑容把话题引开，二乃干脆当你不存在，四叶虽然热情但永远在忙社团的事，五月礼貌而疏远地收下你整理的学习资料，然后一言不发地离开。" },
        { "type": "narrate", "focus": "miku", "text": "至于三玖——她看到你走近就会起身。不慌不忙，不解释，只是合上书，戴上耳机，从你身边走过去。你甚至不确定她有没有意识到自己在躲你，还是说那已经成了她面对「不必要的人际关系」时的本能反应。" },
        { "type": "narrate", "text": "今天午休，你没有去中野家。你去了学校图书室。" },
        { "type": "narrate", "text": "书架上，历史区那一排关于战国时代的书，几乎每一本的借阅卡上都有同一个名字：中野三玖。" },
        { "type": "narrate", "text": "她读得很杂——信长、秀吉、家康、武田信玄、上杉谦信，从通史到人物传记到轶闻集，甚至有一本《甲阳军鉴》的现代译注本，书脊已经被翻得起了毛边。" },
        { "type": "narrate", "text": "你抽出一本《信长公记》的时候，听到身后传来极轻的脚步声，然后停住了。" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "……" },
        { "type": "narrate", "focus": "miku", "text": "她站在书架另一侧的通道口，看着你手里的书。那摞要归还的书抱在胸前，遮住了她半张脸，但你看到她的手指在书脊上收紧了一下。" },
        {
          "type": "choice",
          "options": [
            { "text": "这本我还没看完。你要先还的话，我过两天再借。", "affection": 0, "goto": "scene_library_a" },
            { "text": "你借的这些都读完了？《甲阳军鉴》那本，我翻了十页就放下了。", "affection": 2, "goto": "scene_library_b" },
            { "text": "不用躲。我只是来还书。", "affection": 1, "goto": "scene_library_c" }
          ]
        }
      ]
    },
    {
      "id": "scene_library_a",
      "background": "library",
      "next": "scene_bookshelf",
      "steps": [
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……不用。你先看。" },
        { "type": "narrate", "text": "她把那摞书放在还书台上，转身就要走。" },
        { "type": "say", "who": "you", "text": "三玖。" },
        { "type": "narrate", "focus": "miku", "text": "她停了一步。" },
        { "type": "say", "who": "you", "text": "下周的辅导，你会来吗？" },
        { "type": "narrate", "focus": "miku", "text": "她没有回头。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……再说。" }
      ]
    },
    {
      "id": "scene_library_b",
      "background": "library",
      "next": "scene_bookshelf",
      "steps": [
        { "type": "narrate", "focus": "miku", "text": "三玖的脚步完全停住了。她抱着书，从书架边缘探出半个脑袋，被刘海遮住的右眼后面，那道视线第一次带上了「确认」的意味。" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "……你翻了十页。" },
        { "type": "say", "who": "you", "text": "甲州法度次第的条文太碎了，没有信长那个「天下布武」的印文来得直接。" },
        { "type": "narrate", "focus": "miku", "text": "三玖眨了眨眼。然后她做了一件你没想到的事——她把那摞书放在旁边的阅览桌上，走过来，从你手中抽走了《信长公记》，翻到某一页，指给你看。" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "这里。信长给浓姬的那封信，不是政治文书。是私信。" },
        { "type": "say", "who": "you", "text": "我知道。『浓，岐阜之事，不必挂心。』" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "……" },
        { "type": "narrate", "focus": "miku", "text": "她抬起头看你。刘海从右眼上滑开了一瞬，你第一次看清了她两只眼睛的颜色——是同一种安静的深蓝。" }
      ]
    },
    {
      "id": "scene_library_c",
      "background": "library",
      "next": "scene_bookshelf",
      "steps": [
        { "type": "say", "who": "miku", "face": "school_awake", "text": "我没有躲。" },
        { "type": "narrate", "text": "她说这话的时候，声音比平时稍微大了一点。" },
        { "type": "say", "who": "you", "text": "那你为什么每次看到我就走？" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……因为不知道说什么。" },
        { "type": "narrate", "focus": "miku", "text": "她把书放在还书台上，这次没有立刻离开，而是站在那里，像是不知道接下来该做什么。" }
      ]
    },
    {
      "id": "scene_bookshelf",
      "background": "library",
      "steps": [
        { "type": "narrate", "text": "还书台后的图书委员不在。三玖把书摞好，犹豫了一下，开始一本一本地往书架上放。你走过去，拿起最上面那一本。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……我自己可以。" },
        { "type": "say", "who": "you", "text": "我知道你可以。但两个人快一点。" },
        { "type": "narrate", "focus": "miku", "text": "她没有再说话。" },
        { "type": "narrate", "text": "你们在书架之间安静地走了几个来回。她放书的位置很精确，每一本都回到它原本被取下的地方，像是她记得每一本书原来站在哪一格。" },
        { "type": "narrate", "focus": "miku", "text": "最后一本，是那本《甲阳军鉴》。你伸手要放，她先一步按住了书脊。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "这本……放最上面。我够不到。" },
        { "type": "narrate", "focus": "miku", "text": "她说得很自然，但你注意到，以她的身高，那个格子并不是够不到。" },
        {
          "type": "choice",
          "options": [
            { "text": "（什么也不说，把书放上去。）", "affection": 1, "goto": "scene_shelf_a" },
            { "text": "你其实够得到吧。", "affection": 1, "goto": "scene_shelf_b" },
            { "text": "下次够不到的时候，叫我。", "affection": 2, "goto": "scene_shelf_c" }
          ]
        }
      ]
    },
    {
      "id": "scene_shelf_a",
      "background": "library",
      "next": "scene_courtyard",
      "steps": [
        { "type": "narrate", "text": "你把书推进书架最上层。三玖低声说了一句「谢谢」，声音轻得几乎被书页的回弹声吞掉。" }
      ]
    },
    {
      "id": "scene_shelf_b",
      "background": "library",
      "next": "scene_courtyard",
      "steps": [
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……多嘴。" },
        { "type": "narrate", "focus": "miku", "text": "她转过身，朝走廊走去。但你看到她的耳朵尖在光线里泛了一点粉色。" }
      ]
    },
    {
      "id": "scene_shelf_c",
      "background": "library",
      "next": "scene_courtyard",
      "steps": [
        { "type": "narrate", "focus": "miku", "text": "三玖看了你一眼。这一次她没有立刻移开视线。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……你这个人，真的很奇怪。" },
        { "type": "narrate", "focus": "miku", "text": "她说完就走了。但她走到走廊拐角的时候，脚步慢了一拍，像是在等你跟上来。" }
      ]
    },
    {
      "id": "scene_courtyard",
      "background": "courtyard_dusk",
      "steps": [
        { "type": "narrate", "text": "放学后，你在中庭的长椅上坐下来，翻开从图书室借出来的那本《信长公记》。午后的阳光从树叶间落下来，书页上浮着晃动的光斑。" },
        { "type": "narrate", "text": "你读了大概十分钟，一个人影停在了长椅旁边。" },
        { "type": "narrate", "focus": "miku", "text": "三玖站在那里，脖子上挂着耳机，手里没有书。她的视线落在你手中的书上，表情介于「路过」和「特意走过来」之间。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……你还在看那本。" },
        { "type": "say", "who": "you", "text": "借都借了。" },
        { "type": "narrate", "text": "她沉默了几秒。然后，在你旁边的长椅上坐了下来。隔了一个人的距离。" },
        { "type": "bg", "id": "courtyard_bench_cg" },
        { "type": "narrate", "focus": "miku", "text": "她双手放在膝盖上，视线看向前方而不是你。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "你觉得，信长是个什么样的人？" },
        { "type": "narrate", "text": "这个问题问得很轻，但你知道它不是随口一问。" },
        {
          "type": "choice",
          "options": [
            { "text": "有魄力，但太急。火烧比叡山那件事，他不给自己留退路。", "affection": 1, "goto": "scene_nobunaga_a" },
            { "text": "我不太喜欢他。但他确实改变了时代。", "affection": 2, "goto": "scene_nobunaga_b" },
            { "text": "我想先听听你怎么看。", "affection": 3, "goto": "scene_nobunaga_c" }
          ]
        }
      ]
    },
    {
      "id": "scene_nobunaga_a",
      "background": "courtyard_dusk",
      "next": "scene_wordchain",
      "steps": [
        { "type": "narrate", "focus": "miku", "text": "三玖轻轻点了一下头，动作很小。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……我也这么觉得。他太快了。快到来不及看清身边的人。" },
        { "type": "narrate", "focus": "miku", "text": "她停了一下。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "但如果不快的话，他什么都改变不了。" }
      ]
    },
    {
      "id": "scene_nobunaga_b",
      "background": "courtyard_dusk",
      "next": "scene_wordchain",
      "steps": [
        { "type": "say", "who": "miku", "face": "school_normal", "text": "不喜欢。" },
        { "type": "narrate", "focus": "miku", "text": "她重复了这两个字，语气里没有反驳的意思，反而像是理解了什么。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "很多人都说喜欢信长。但喜欢一个人，和看见他的缺点，可以同时成立。" },
        { "type": "narrate", "focus": "miku", "text": "她低下头，声音更轻了。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……我觉得那样比较好。" }
      ]
    },
    {
      "id": "scene_nobunaga_c",
      "background": "courtyard_dusk",
      "next": "scene_wordchain",
      "steps": [
        { "type": "narrate", "focus": "miku", "text": "三玖微微偏过头。她的刘海在这个角度下遮住了右眼，但你看到她的左眼里有一瞬间的意外。" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "你问我？" },
        { "type": "say", "who": "you", "text": "你在图书室把每一本书都放回原位。你比我更认真读了这些东西。我想听你的。" },
        { "type": "narrate", "text": "她沉默了很久。长椅旁边的树被风吹了一下。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……信长是个孤独的人。他做的事情，同时代的人大多看不懂。但他没有停下来解释。" },
        { "type": "narrate", "focus": "miku", "text": "她把手放在膝盖上，指尖轻轻并拢。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "我……觉得那样很厉害。但我做不到。" }
      ]
    },
    {
      "id": "scene_wordchain",
      "background": "courtyard_dusk",
      "steps": [
        { "type": "narrate", "text": "气氛沉下来了几秒。三玖似乎觉得自己说了太多，手指摸向脖子上的耳机。" },
        { "type": "narrate", "text": "你没有给她戴上耳机的机会。" },
        { "type": "say", "who": "you", "text": "三玖。来玩个游戏。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……游戏？" },
        { "type": "say", "who": "you", "text": "武将接龙。我说一个，你接一个。接不上的人请喝饮料。" },
        { "type": "narrate", "focus": "miku", "text": "三玖的手指停在耳机上。她看着你，像是在判断你是不是认真的。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……你确定？" },
        { "type": "say", "who": "you", "text": "信长。" },
        { "type": "narrate", "focus": "miku", "text": "三玖的表情发生了极细微的变化——眉梢挑了一下，像是被挑起了什么。" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "……长久手。" },
        { "type": "say", "who": "you", "text": "手取川。" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "……川中岛。" },
        { "type": "say", "who": "you", "text": "岛津义弘。" },
        { "type": "bg", "id": "word_chain_cg" },
        { "type": "narrate", "focus": "miku", "text": "三玖的语速变快了，声音也比平时清晰。她的眼睛亮了起来，那种光和她低头看书时完全不一样。" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "弘前。……不，弘治。" },
        { "type": "say", "who": "you", "text": "治部少辅。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "辅……辅佐？" },
        { "type": "narrate", "focus": "miku", "text": "她卡住了。" },
        {
          "type": "choice",
          "options": [
            { "text": "时间到。你欠我一瓶饮料。", "affection": 1, "goto": "scene_chain_a" },
            { "text": "提示：关原。", "affection": 2, "goto": "scene_chain_b" },
            { "text": "（假装自己也卡住了。）……我也接不上。平局。", "affection": 2, "goto": "scene_chain_c" }
          ]
        }
      ]
    },
    {
      "id": "scene_chain_a",
      "background": "courtyard_dusk",
      "next": "scene_kitchen",
      "steps": [
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……我知道。不用你说。" },
        { "type": "narrate", "focus": "miku", "text": "她别过脸，但嘴角的线条没有绷紧。那是你第一次在她脸上看到近似「不服气」的表情。" }
      ]
    },
    {
      "id": "scene_chain_b",
      "background": "courtyard_dusk",
      "next": "scene_kitchen",
      "steps": [
        { "type": "narrate", "focus": "miku", "text": "三玖的眼睛眯了一下。" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "不需要提示。" },
        { "type": "narrate", "focus": "miku", "text": "她想了三秒。" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "辅……辅弼。大谷吉继的『吉』。" },
        { "type": "say", "who": "you", "text": "吉川元春。" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "春……春日山。上杉谦信。" },
        { "type": "narrate", "focus": "miku", "text": "她接上了。而且她看着你的眼神，像是在说「继续」。" }
      ]
    },
    {
      "id": "scene_chain_c",
      "background": "courtyard_dusk",
      "next": "scene_kitchen",
      "steps": [
        { "type": "narrate", "focus": "miku", "text": "三玖看着你，安静了一拍。" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "……你在让我。" },
        { "type": "say", "who": "you", "text": "没有。我也卡住了。" },
        { "type": "say", "who": "miku", "face": "school_awake", "text": "你刚才说到「治部少辅」的时候，没有犹豫。" },
        { "type": "narrate", "focus": "miku", "text": "她拆穿得很平静。但你注意到，她的语气里没有不高兴。" },
        { "type": "say", "who": "miku", "face": "school_normal", "text": "……平局就平局。下次不会让你了。" },
