<?xml version="1.0" encoding="utf-8"?>
<!-- 剧情选项卡：左侧小圆点 + 纸感底；选中态品牌粉实底 + 白色圆点 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/edenColorAccent" />
                    <corners android:radius="@dimen/radius_medium" />
                </shape>
            </item>
            <item
                android:width="9dp"
                android:height="9dp"
                android:gravity="start|center_vertical"
                android:left="16dp">
                <shape android:shape="oval">
                    <solid android:color="?attr/edenColorOnPrimary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#E8FFFFFF" />
                    <corners android:radius="@dimen/radius_medium" />
                    <stroke
                        android:width="1dp"
                        android:color="?attr/edenColorBorder" />
                </shape>
            </item>
            <item
                android:width="9dp"
                android:height="9dp"
                android:gravity="start|center_vertical"
                android:left="16dp">
                <shape android:shape="oval">
                    <solid android:color="?attr/edenColorAccent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
