<?xml version="1.0" encoding="utf-8"?>
<!-- 心情 / 标签 chip 通用背景：选中态粉色填充，默认白底浅粉描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/edenColorPrimary" />
            <corners android:radius="@dimen/radius_large" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/edenColorSurface" />
            <corners android:radius="@dimen/radius_large" />
            <stroke
                android:width="1dp"
                android:color="?attr/edenColorBorder" />
        </shape>
    </item>
</selector>
