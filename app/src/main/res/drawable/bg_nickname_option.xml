<?xml version="1.0" encoding="utf-8"?>
<!-- 称呼选项行背景：选中态粉色填充白字，默认浅粉底 + 粉描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/edenColorAccent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/edenColorSurfaceTint" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/edenColorBorder" />
        </shape>
    </item>
</selector>
