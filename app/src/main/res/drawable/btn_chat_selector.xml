<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FF66CC" />
            <stroke
                android:width="3dp"
                android:color="#FF3388" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF8EFF"
                android:endColor="#FF66CC"
                android:angle="45" />
            <stroke
                android:width="3dp"
                android:color="#FF3388" />
        </shape>
    </item>
</selector>