<?xml version="1.0" encoding="utf-8"?>
<!-- 游戏卡片背景：浅粉填充 + 粉色描边，按下态加深 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/edenColorChipBg" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/edenColorAccentLight" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/edenColorSurfaceTint" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/edenColorBorder" />
        </shape>
    </item>
</selector>
