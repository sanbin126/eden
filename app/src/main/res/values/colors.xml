<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
         Eden 颜色总表（换主题色的唯一入口）

         规则：界面布局 / drawable / Kotlin 一律引用下面的「语义名」
         （eden_primary、eden_text_primary …），不要再直接写 #RRGGBB。
         这样想整体换色时，只改本文件即可。
         想新增一套配色，就照抄一份改名（见下方 Ocean 示例）。
    -->

    <!-- 默认皮肤：樱粉 Pink -->
    <!-- 品牌主色 -->
    <color name="eden_primary">#FF66CC</color>
    <color name="eden_primary_pressed">#E91E63</color>
    <color name="eden_primary_deep">#FF3388</color>
    <color name="eden_primary_light">#FF8EFF</color>
    <color name="eden_accent">#FF4081</color>
    <color name="eden_accent_light">#FF9CC8</color>

    <!-- 背景渐变 -->
    <color name="eden_gradient_start">#FFE6F2</color>
    <color name="eden_gradient_end">#E6B0FF</color>

    <!-- 表面 / 卡片 / 描边 -->
    <color name="eden_surface">#FFFFFF</color>
    <color name="eden_surface_tint">#FFF0F6</color>
    <color name="eden_chip_bg">#FFE3F1</color>
    <color name="eden_border">#FFC1DE</color>

    <!-- 文字 -->
    <color name="eden_text_primary">#333333</color>
    <color name="eden_text_secondary">#888888</color>
    <color name="eden_text_tertiary">#999999</color>
    <color name="eden_text_hint">#BBBBBB</color>
    <color name="eden_on_primary">#FFFFFF</color>

    <!-- 图标 -->
    <color name="eden_icon">#666666</color>
    <color name="eden_icon_disabled">#CCCCCC</color>

    <!-- 中性底 / 分隔线 -->
    <color name="eden_neutral_bg">#F7F7F9</color>
    <color name="eden_neutral_bg_alt">#F0F0F2</color>
    <color name="eden_divider">#EEEEEE</color>
    <color name="eden_divider_alt">#F0F0F0</color>
    <color name="eden_border_neutral">#E0E0E0</color>

    <!-- 状态色 -->
    <color name="eden_danger">#FF5252</color>
    <color name="eden_success">#4CAF50</color>

    <!-- 遮罩 -->
    <color name="eden_scrim">#88000000</color>
    <color name="eden_scrim_light">#44000000</color>

    <!-- 主界面问候语随机色（原 MainActivity 里硬编码的一串粉色） -->
    <color name="eden_greet_1">#FF69B4</color>
    <color name="eden_greet_2">#FF1493</color>
    <color name="eden_greet_3">#FFB6C1</color>
    <color name="eden_greet_4">#FF85A2</color>
    <color name="eden_greet_5">#FF4081</color>

    <array name="eden_greeting_colors">
        <item>@color/eden_greet_1</item>
        <item>@color/eden_greet_2</item>
        <item>@color/eden_greet_3</item>
        <item>@color/eden_greet_4</item>
        <item>@color/eden_greet_5</item>
    </array>

    <!-- 示例皮肤：海洋蓝 Ocean
         换肤 = 这样再写一套颜色，然后建一个继承 Theme.Eden 的主题
         （见 themes.xml 的 Theme.Eden.Skin.Ocean）。 -->
    <color name="eden_ocean_primary">#33A6E0</color>
    <color name="eden_ocean_primary_pressed">#1976D2</color>
    <color name="eden_ocean_primary_deep">#0D8FD1</color>
    <color name="eden_ocean_primary_light">#8ED6FF</color>
    <color name="eden_ocean_accent">#2196F3</color>
    <color name="eden_ocean_accent_light">#9CC9E8</color>
    <color name="eden_ocean_gradient_start">#E6F4FF</color>
    <color name="eden_ocean_gradient_end">#B0E0FF</color>
    <color name="eden_ocean_surface_tint">#F0F8FF</color>
    <color name="eden_ocean_chip_bg">#E3F2FD</color>
    <color name="eden_ocean_border">#C1DEF0</color>
</resources>
