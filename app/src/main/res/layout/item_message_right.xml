<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginVertical="@dimen/space_4"
    android:paddingStart="@dimen/space_64"
    android:paddingEnd="@dimen/space_12"
    android:gravity="end">

    <!--
        气泡容器：layout_width=0dp + layout_weight=1 会在测量阶段先扣掉右侧头像（40dp + 8dp）的宽度，
        保证长消息气泡最宽只占「内容区 - 头像宽度」，不会把根布局的 paddingStart 撑破。
        否则气泡会侵入 64dp 的左侧 padding，被根布局默认的 clipToPadding 裁掉左侧圆角与每行首字（显示不全）。
    -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="end">

        <!-- 消息内容 -->
        <TextView
            android:id="@+id/tv_message_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_right"
            android:padding="@dimen/space_12"
            android:textColor="?attr/edenColorOnPrimary"
            android:textSize="16sp" />

        <!-- 时间戳 -->
        <TextView
            android:id="@+id/tv_time_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/common_time_placeholder"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 用户头像：与设置页一致，圆形裁剪，优先展示用户自定义头像 -->
    <com.example.eden.core.ui.CircleImageView
        android:id="@+id/iv_avatar_right"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/space_8"
        android:src="@drawable/ic_user_avatar" />

</LinearLayout>
