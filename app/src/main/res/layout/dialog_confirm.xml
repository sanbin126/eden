<?xml version="1.0" encoding="utf-8"?>
<!-- 通用确认弹窗：居中粉色卡片，样式对齐角色详情 / 小游戏面板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_character_detail"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <ImageView
        android:id="@+id/confirm_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_game_icon"
        android:contentDescription="@string/common_hint"
        android:padding="@dimen/space_16"
        android:src="@drawable/ic_info" />

    <TextView
        android:id="@+id/confirm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:textColor="?attr/edenColorAccent"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="#555555"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/confirm_negative"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_game_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textColor="#B08FA0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/confirm_positive"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textColor="?attr/edenColorOnPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
