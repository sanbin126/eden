<?xml version="1.0" encoding="utf-8"?>
<!-- 「我的名字」设置面板：粉色卡片式，样式对齐小游戏 / 环境音选择面板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/myNameSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_game_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingTop="@dimen/space_12"
    android:paddingEnd="@dimen/space_20"
    android:paddingBottom="@dimen/space_24">

    <!-- 顶部拖动条 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_game_handle" />

    <!-- 标题区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_game_icon"
            android:contentDescription="@string/my_name_cd"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_user_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_name_title"
                android:textColor="?attr/edenColorAccent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/my_name_sub"
                android:textColor="#B08FA0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 全名 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:text="@string/my_name_full_label"
        android:textColor="?attr/edenColorAccent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etMyNameFormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_edit_box"
        android:hint="@string/my_name_full_hint"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_12"
        android:textColor="?attr/edenColorTextPrimary"
        android:textColorHint="#C9A9B8"
        android:textSize="14sp" />

    <!-- 小名 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/my_name_short_label"
        android:textColor="?attr/edenColorAccent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etMyNameCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_edit_box"
        android:hint="@string/my_name_short_hint"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_12"
        android:textColor="?attr/edenColorTextPrimary"
        android:textColorHint="#C9A9B8"
        android:textSize="14sp" />

    <!-- 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMyNameCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_button"
            android:backgroundTint="@null"
            android:text="@string/common_cancel"
            android:textAllCaps="false"
            android:textColor="?attr/edenColorPrimary"
            android:textSize="14sp" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnMyNameSave"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:backgroundTint="@null"
            android:text="@string/common_save"
            android:textAllCaps="false"
            android:textColor="?attr/edenColorOnPrimary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
