<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_main_gradient">

    <!-- 顶部：返回 + 标题 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/game_name_xiangqi"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="28dp"
            android:layout_height="28dp" />
    </LinearLayout>

    <!-- 三玖 QQ 人 + 气泡：高度固定，避免气泡出现/消失时下方部件上下移动 -->
    <FrameLayout
        android:id="@+id/miku_area"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="@dimen/space_4"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <ImageView
            android:id="@+id/iv_miku_chibi"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="?attr/edenCharChibi" />

        <TextView
            android:id="@+id/tv_miku_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_72"
            android:background="@drawable/bg_bubble_touch"
            android:gravity="center"
            android:maxWidth="260dp"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_8"
            android:textColor="?attr/edenColorTextPrimary"
            android:textSize="13sp"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- AI 难度 -->
    <LinearLayout
        android:id="@+id/difficulty_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/miku_area">

        <Button
            android:id="@+id/btn_easy"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="@dimen/space_16"
            android:text="@string/common_difficulty_easy"
            android:textColor="?attr/edenColorTextPrimary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_medium"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/space_12"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="@dimen/space_16"
            android:text="@string/common_difficulty_medium"
            android:textColor="?attr/edenColorTextPrimary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_hard"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/space_12"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="@dimen/space_16"
            android:text="@string/common_difficulty_hard"
            android:textColor="?attr/edenColorTextPrimary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 状态栏：提示 + 重开 -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/difficulty_bar">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/xiangqi_status_red"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_restart"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_small_button"
            android:gravity="center"
            android:text="@string/common_status_emoji"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 棋盘：9×10 交叉点，视图内部自适应居中 -->
    <com.example.eden.feature.game.XiangqiBoardView
        android:id="@+id/board_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>
