<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:fitsSystemWindows="true"
    tools:context=".MilestoneStoryActivity">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/space_8"
            android:background="@drawable/ic_back"
            android:backgroundTint="@null"
            android:padding="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_story_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/milestone_story_title"
                android:textColor="?attr/edenColorOnPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_story_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/milestone_story_intimacy"
                android:textColor="#FFC0CB"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 剧情对话列表（复用聊天气泡样式） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_options"
        android:layout_below="@+id/top_bar"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8" />

    <!-- 底部选项区：三玖抛出选项时逐条塞入按钮；不出选项时该区域为空不可见 -->
    <LinearLayout
        android:id="@+id/ll_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="?attr/edenColorScrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12" />

</RelativeLayout>
