<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:fitsSystemWindows="true"
    tools:context=".MilestoneStoryListActivity">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/space_8"
            android:background="@drawable/ic_back"
            android:backgroundTint="@null"
            android:padding="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_weight="1"
            android:text="@string/milestone_list_title"
            android:textColor="?attr/edenColorOnPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_milestone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top_bar"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_16" />

    <!-- 一条都没解锁时的空状态引导 -->
    <TextView
        android:id="@+id/tv_milestone_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:paddingStart="@dimen/space_32"
        android:paddingEnd="@dimen/space_32"
        android:text="@string/milestone_list_empty"
        android:textColor="?attr/edenColorTextOnDarkSecondary"
        android:textSize="14sp"
        android:visibility="gone" />

</RelativeLayout>
