<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_8"
    app:cardBackgroundColor="?attr/edenColorSurface"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="2dp">

    <LinearLayout
        android:id="@+id/item_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_16">

        <com.example.eden.core.ui.CircleImageView
            android:id="@+id/iv_profile_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/profile_avatar_cd"
            android:src="@drawable/ic_user_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/settings_not_logged_in"
                android:textColor="?attr/edenColorTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/common_dash"
                android:textColor="?attr/edenColorTextTertiary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_signature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                android:textColor="?attr/edenColorTextTertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="@dimen/space_8"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
