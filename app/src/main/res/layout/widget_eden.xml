<?xml version="1.0" encoding="utf-8"?>
<!--
    桌面小组件（4×2）：立绘 + 今日心情 + 一句话，整块可点击进入聊天。
    RemoteViews 只支持有限的系统控件与属性，这里不要换成自定义 View / Compose。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_eden"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/widget_portrait"
        android:layout_width="78dp"
        android:layout_height="96dp"
        android:contentDescription="@string/widget_portrait_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_miku" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_name"
            android:textColor="@color/eden_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_mood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_widget_mood"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/eden_primary_deep"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/eden_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
