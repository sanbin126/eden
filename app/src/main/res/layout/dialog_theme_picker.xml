<?xml version="1.0" encoding="utf-8"?>
<!-- 「主题」选择面板：样式对齐亲密称呼 / 小游戏选择面板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/themeSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_game_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingTop="@dimen/space_12"
    android:paddingEnd="@dimen/space_20"
    android:paddingBottom="@dimen/space_24">

    <!-- 顶部拖动条 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_game_handle" />

    <!-- 标题区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_game_icon"
            android:contentDescription="@string/theme_picker_title"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_palette" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_picker_title"
                android:textColor="?attr/edenColorAccent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/theme_picker_sub"
                android:textColor="?attr/edenColorTextTertiary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 选项容器（代码动态填充） -->
    <LinearLayout
        android:id="@+id/llThemeOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:orientation="vertical" />

    <!-- 底部取消按钮 -->
    <Button
        android:id="@+id/btnThemeCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/space_20"
        android:background="@drawable/bg_outline_button"
        android:backgroundTint="@null"
        android:text="@string/common_cancel"
        android:textAllCaps="false"
        android:textColor="?attr/edenColorPrimary"
        android:textSize="14sp" />
</LinearLayout>
