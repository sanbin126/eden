<?xml version="1.0" encoding="utf-8"?>
<!-- 投喂 / 送礼面板里的单件物品行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/giftRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_8"
    android:background="@drawable/bg_game_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_12">

    <TextView
        android:id="@+id/tvGiftEmoji"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_game_icon"
        android:gravity="center"
        android:text="@string/item_gift_emoji"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGiftName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/item_gift_name"
            android:textColor="?attr/edenColorTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGiftSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/item_gift_sub"
            android:textColor="#B08FA0"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGiftCost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/item_gift_cost"
        android:textColor="?attr/edenColorAccent"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
