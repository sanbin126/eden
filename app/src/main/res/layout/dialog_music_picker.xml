<?xml version="1.0" encoding="utf-8"?>
<!-- 背景音乐选择面板：粉色卡片式，样式对齐小游戏 / 环境音选择面板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/musicPickerSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_game_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingTop="@dimen/space_12"
    android:paddingEnd="@dimen/space_20"
    android:paddingBottom="@dimen/space_24">

    <!-- 顶部拖动条 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_game_handle" />

    <!-- 标题区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_game_icon"
            android:contentDescription="@string/music_picker_cd"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_music" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/music_picker_title"
                android:textColor="?attr/edenColorAccent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/music_picker_sub"
                android:textColor="#B08FA0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 播放内置环境音 -->
    <LinearLayout
        android:id="@+id/item_ambient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:background="@drawable/bg_game_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_16">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_game_icon"
            android:contentDescription="@string/music_picker_builtin_cd"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_music" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:text="@string/music_picker_builtin"
            android:textColor="?attr/edenColorTextPrimary"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <!-- 选择本地音乐 -->
    <LinearLayout
        android:id="@+id/item_local"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/bg_game_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_16">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_game_icon"
            android:contentDescription="@string/music_picker_local_cd"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_play" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:text="@string/music_picker_local"
            android:textColor="?attr/edenColorTextPrimary"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <!-- 停止播放 -->
    <LinearLayout
        android:id="@+id/item_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/bg_game_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_16">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_game_icon"
            android:contentDescription="@string/music_picker_stop_cd"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_pause"
            app:tint="?attr/edenColorPrimaryPressed" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:text="@string/music_picker_stop"
            android:textColor="?attr/edenColorPrimaryPressed"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>
</LinearLayout>
