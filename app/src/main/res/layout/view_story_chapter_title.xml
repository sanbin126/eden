<?xml version="1.0" encoding="utf-8"?>
<!-- 章节标题演出卡：黑场之上居中展示「第X章 / 标题 / 引子 / 开始·跳过」 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20E0B16"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_32"
        android:paddingEnd="@dimen/space_32">

        <TextView
            android:id="@+id/tv_title_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_story_nameplate"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_4"
            android:textColor="?attr/edenColorOnPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="第一章" />

        <TextView
            android:id="@+id/tv_title_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:letterSpacing="0.12"
            android:textColor="?attr/edenColorTextOnDarkSecondary"
            android:textSize="12sp"
            tools:text="CHAPTER 01" />

        <TextView
            android:id="@+id/tv_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="那个屋檐下，耳机女孩" />

        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/space_16"
            android:background="?attr/edenColorAccent" />

        <TextView
            android:id="@+id/tv_title_synopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:textColor="?attr/edenColorTextOnDarkSecondary"
            android:textSize="14sp"
            tools:text="你接下了中野家的委托，成为五胞胎姐妹的家庭教师。" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_36"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_title_start"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_primary"
                android:minWidth="104dp"
                android:paddingStart="@dimen/space_28"
                android:paddingEnd="@dimen/space_28"
                android:text="@string/story_start"
                android:textColor="?attr/edenColorOnPrimary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_title_skip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_16"
                android:background="@drawable/bg_outline_button"
                android:minWidth="104dp"
                android:paddingStart="@dimen/space_28"
                android:paddingEnd="@dimen/space_28"
                android:text="@string/story_restart"
                android:textColor="?attr/edenColorOnPrimary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
