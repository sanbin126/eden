<?xml version="1.0" encoding="utf-8"?>
<!-- 专注任务单条卡片：点击选中为当前任务，右侧可删除 -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    app:cardBackgroundColor="?attr/edenColorSurface"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_16">

        <ImageView
            android:id="@+id/iv_task_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_circle_pink"
            android:contentDescription="@string/item_focus_dot_cd" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/item_focus_title"
                android:textColor="?attr/edenColorTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_task_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/item_focus_progress"
                android:textColor="?attr/edenColorPrimary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_task_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/item_focus_delete_cd"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_delete"
            app:tint="?attr/edenColorIconDisabled" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
