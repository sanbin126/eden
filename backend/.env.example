# Eden AI 代理后端环境变量示例
# 复制本文件为 .env 并填入真实值即可（.env 不要提交到 git）。
#
# ⚠️ 警告：如果同目录下已存在 .env（内含真实凭据、且不在 git 里），请勿用本示例文件覆盖它！
#    .env 被覆盖后无法通过 git 恢复，只会丢配置。新增项请手动追加到 .env，不要整文件替换。

# ===== 必填：大模型配置 =====
# 火山方舟 API Key，在 https://console.volcengine.com/ark 获取
ARK_API_KEY=your_ark_api_key_here

# 大模型 OpenAI 兼容接口地址（火山方舟默认值，一般无需修改）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/

# 模型名或推理接入点 ID（如 doubao-pro-32k / ep-2024xxxxxxxx）
ARK_MODEL_NAME=your_model_or_endpoint_id

# ===== 可选：简单请求校验 =====
# 设置后，客户端请求必须带 Authorization: Bearer <APP_TOKEN>。
# 留空或不写 = 不校验，方便本地联调。
APP_TOKEN=

# ===== 可选：请求超时与重试（提升线上稳定性）=====
# 单次上游请求超时（秒）。大模型首字延迟较高，建议不小于 60。
REQUEST_TIMEOUT=60

# 上游超时 / 500 时的最大重试次数，间隔按指数退避（1s / 2s / 4s）。
UPSTREAM_MAX_RETRIES=3
UPSTREAM_RETRY_BASE_DELAY=1.0

# ===== 可选：联网搜索（让模型能回答现实世界的事实问题）=====
# 留空 SEARCH_API_KEY = 关闭联网能力，行为与未接入前完全一致。
# 配置后，模型会按需调用搜索工具，再基于检索结果作答。
# 当前默认适配「博查 BochaAI」（https://open.bochaai.com 申请 API Key）。
# 换成其它服务商时，只需改写 backend/app/main.py 里的 run_web_search() 一个函数。
SEARCH_PROVIDER=bocha
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.bochaai.com/v1/web-search
# 单次搜索返回的结果条数
SEARCH_MAX_RESULTS=5
# 单次搜索请求超时（秒）
SEARCH_TIMEOUT=15
# 工具调用最大轮数（防止无限「搜索 → 再搜索」循环）
SEARCH_MAX_ROUNDS=2

# 供云托管使用的监听端口，容器内部固定为 80，无需修改。
PORT=80

# ===== 必填：SMTP 邮件服务（发送邮箱验证码）=====
# QQ 邮箱：需先在「设置 - 账户」开启 SMTP 服务并生成授权码（不是登录密码）。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_account@qq.com
SMTP_AUTH_CODE=your_smtp_auth_code

# 发件人显示名
SMTP_SENDER_NAME=中野三玖

# 验证码有效期（秒），默认 5 分钟
CODE_TTL_SECONDS=300

# 同一邮箱重发验证码的冷却时间（秒），默认 60 秒
CODE_RESEND_INTERVAL_SECONDS=60

# ===== 可选：账号持久化与登录态（JWT）=====
# SQLite 数据库文件路径。留空则默认使用 app/eden.db（账号主体与业务数据都存这里）。
# 注意：云托管容器为无状态，容器重建会丢失该文件；如需长期保存请挂载持久化存储/云数据库。
DB_PATH=

# JWT 签名密钥。留空则自动生成并写入 app/.jwt_secret（重启后已签发 token 依旧有效）。
# 多实例部署时必须显式配置同一个密钥，否则各实例签发的 token 互不认可。
JWT_SECRET=

# JWT 有效期（天），默认 30 天
JWT_EXPIRE_DAYS=30
